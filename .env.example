# ==============================================================================
# LLM Provider Configuration
# Choose between: google, openai
# ==============================================================================
LLM_PROVIDER=google

# ------------------------------------------------------------------------------
# Google Gemini Configuration
# Obtain your key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# OpenAI Configuration (Optional - easily switch to OpenAI by changing LLM_PROVIDER=openai)
# Obtain your key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
